#!/bin/sh

set -eu

TOKEN=--serve
DIAGNOSE_TOKEN=--diagnose-install

usage() {
    echo "usage: $0 $TOKEN RAW_FIRST [VIDEO_NUMBER] [EXPOSURE_MS] [GAIN] [MODE]" >&2
    echo "       $0 $DIAGNOSE_TOKEN" >&2
    echo "       MODE 2 exposes 1280x960 (default); MODE 0 exposes 3664x2748" >&2
    echo "       optional TCA_TIMESTAMPS writes the reader's monotonic CSV sidecar" >&2
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)

if [ -n "${TCA_CAMERA_READER:-}" ]; then
    reader=$TCA_CAMERA_READER
elif [ -x "$script_dir/tca-camera" ]; then
    reader=$script_dir/tca-camera
elif [ -x "$project_dir/build/tca-camera" ]; then
    reader=$project_dir/build/tca-camera
else
    reader=$project_dir/build/tca-camera
fi

if [ -n "${TCA_FLAT_FIELD_TOOL:-}" ]; then
    flat_field_tool=$TCA_FLAT_FIELD_TOOL
elif [ -x "$script_dir/tca-flat-field" ]; then
    flat_field_tool=$script_dir/tca-flat-field
elif [ -x "$project_dir/build/tca-flat-field" ]; then
    flat_field_tool=$project_dir/build/tca-flat-field
else
    flat_field_tool=$project_dir/build/tca-flat-field
fi

if [ "$#" -eq 1 ] && [ "$1" = "$DIAGNOSE_TOKEN" ]; then
    reader_executable=0
    flat_field_executable=0
    [ -x "$reader" ] && reader_executable=1
    [ -x "$flat_field_tool" ] && flat_field_executable=1
    printf 'bridge=%s\n' "$0"
    printf 'reader=%s executable=%s\n' "$reader" "$reader_executable"
    printf 'flat_field_tool=%s executable=%s\n' \
        "$flat_field_tool" "$flat_field_executable"
    printf 'NO USB TRANSFER SENT.\n'
    exit 0
fi

if [ "$#" -eq 0 ]; then
    usage
    echo "NO USB TRANSFER SENT." >&2
    exit 0
fi
if [ "$#" -lt 2 ] || [ "$#" -gt 6 ] || [ "$1" != "$TOKEN" ]; then
    usage
    echo "NO USB TRANSFER SENT." >&2
    exit 64
fi

raw_output=$2
video_number=${3:-42}
exposure_ms=${4:-400}
gain=${5:-20}
mode=${6:-2}
timestamps=${TCA_TIMESTAMPS:-}
device=/dev/video${video_number}
loaded=0
reader_pid=0
writer_pid=0
filter_pid=0
stream_dir=
requested_exit=0

cleanup() {
    if [ "$reader_pid" -ne 0 ]; then
        kill "$reader_pid" 2>/dev/null || true
        wait "$reader_pid" 2>/dev/null || true
    fi
    if [ "$writer_pid" -ne 0 ]; then
        kill "$writer_pid" 2>/dev/null || true
        wait "$writer_pid" 2>/dev/null || true
    fi
    if [ "$filter_pid" -ne 0 ]; then
        kill "$filter_pid" 2>/dev/null || true
        wait "$filter_pid" 2>/dev/null || true
    fi
    if [ "$loaded" -eq 1 ]; then
        sudo /usr/sbin/modprobe -r v4l2loopback || true
    fi
    if [ -n "$stream_dir" ] && [ -p "$stream_dir/bayer.fifo" ]; then
        rm -f -- "$stream_dir/bayer.fifo"
    fi
    if [ -n "$stream_dir" ] && [ -p "$stream_dir/raw-bayer.fifo" ]; then
        rm -f -- "$stream_dir/raw-bayer.fifo"
    fi
    if [ -n "$stream_dir" ] && [ -d "$stream_dir" ]; then
        rmdir -- "$stream_dir" 2>/dev/null || true
    fi
}

request_exit() {
    requested_exit=$1
    if [ "$reader_pid" -ne 0 ]; then
        kill -TERM "$reader_pid" 2>/dev/null || true
    else
        exit "$requested_exit"
    fi
}

trap cleanup EXIT
trap 'request_exit 129' HUP
trap 'request_exit 130' INT
trap 'request_exit 143' TERM

for value in "$video_number" "$exposure_ms" "$gain" "$mode"; do
    case "$value" in
        ''|*[!0-9]*)
            echo "video number, exposure, gain, and mode must be decimal integers" >&2
            exit 64
            ;;
    esac
done
case "$mode" in
    0)
        width=3664
        height=2748
        max_exposure_ms=1236
        ;;
    2)
        width=1280
        height=960
        max_exposure_ms=480
        ;;
    *)
        echo "MODE must be 0 or 2" >&2
        exit 64
        ;;
esac
if [ "$exposure_ms" -lt 1 ] || [ "$exposure_ms" -gt "$max_exposure_ms" ] ||
   [ "$gain" -gt 320 ]; then
    echo "control range: MODE=$mode EXPOSURE_MS=1..$max_exposure_ms, GAIN=0..320" >&2
    exit 64
fi
if [ "$raw_output" = - ] || [ -e "$raw_output" ]; then
    echo "RAW_FIRST must name a new regular file: $raw_output" >&2
    exit 73
fi
if [ -n "$timestamps" ]; then
    if [ "$timestamps" = - ] || [ -e "$timestamps" ] ||
       [ "$timestamps" = "$raw_output" ]; then
        echo "TCA_TIMESTAMPS must name a distinct new regular file: $timestamps" >&2
        exit 73
    fi
fi
if [ "$(uname -s)" != Linux ]; then
    echo "the V4L2 adapter requires Linux; the reader core is portable" >&2
    exit 69
fi
if [ ! -x "$reader" ]; then
    echo "missing $reader; run 'make linux-stream-reader' first" >&2
    exit 69
fi
flat_field=${TCA_FLAT_FIELD:-}
if [ -n "$flat_field" ]; then
    if [ ! -r "$flat_field" ]; then
        echo "flat-field calibration is not readable: $flat_field" >&2
        exit 69
    fi
    if [ ! -x "$flat_field_tool" ]; then
        echo "missing $flat_field_tool; run 'make' first" >&2
        exit 69
    fi
    if ! flat_field_metadata=$(
        "$flat_field_tool" inspect --calibration "$flat_field"
    ); then
        echo "flat-field calibration is invalid: $flat_field" >&2
        exit 65
    fi
    if ! printf '%s\n' "$flat_field_metadata" |
         grep -q "\"width\": $width," ||
       ! printf '%s\n' "$flat_field_metadata" |
         grep -q "\"height\": $height," ||
       ! printf '%s\n' "$flat_field_metadata" | grep -q '"phase": "grbg",'; then
        echo "flat-field calibration must be ${width}x${height} GRBG for mode $mode" >&2
        exit 65
    fi
    if ! printf '%s\n' "$flat_field_metadata" |
         grep -q "\"exposure_ms\": $exposure_ms," ||
       ! printf '%s\n' "$flat_field_metadata" |
         grep -q "\"camera_gain\": $gain,"; then
        echo "flat-field exposure/gain must match the requested V4L2 controls" >&2
        exit 65
    fi
fi
for command in ffmpeg mkfifo mktemp sudo v4l2-ctl; do
    if ! command -v "$command" >/dev/null 2>&1; then
        echo "missing command: $command" >&2
        exit 69
    fi
done
if [ ! -x /usr/sbin/modprobe ]; then
    echo "missing /usr/sbin/modprobe" >&2
    exit 69
fi
if grep -q '^v4l2loopback ' /proc/modules 2>/dev/null; then
    echo "v4l2loopback is already loaded; refusing to alter an existing setup" >&2
    exit 73
fi
if [ -e "$device" ]; then
    echo "device already exists: $device" >&2
    exit 73
fi

sudo /usr/sbin/modprobe v4l2loopback video_nr="$video_number" \
    card_label="TCA Camera 0547:c003" exclusive_caps=1 max_buffers=4
loaded=1

attempt=0
while [ ! -e "$device" ] && [ "$attempt" -lt 50 ]; do
    sleep 0.1
    attempt=$((attempt + 1))
done
if [ ! -e "$device" ]; then
    echo "loopback device did not appear: $device" >&2
    exit 1
fi
sudo chown "$(id -u):$(id -g)" "$device"

stream_dir=$(mktemp -d "${TMPDIR:-/tmp}/tca-v4l2-live.XXXXXX")
mkfifo "$stream_dir/bayer.fifo"

start_reader() {
    reader_output=$1
    if [ -n "$timestamps" ]; then
        "$reader" capture --frames 0 --raw-first "$raw_output" \
            --bayer - --timestamps "$timestamps" \
            --mode "$mode" \
            --exposure-ms "$exposure_ms" --gain "$gain" \
            >"$reader_output" &
    else
        "$reader" capture --frames 0 --raw-first "$raw_output" \
            --bayer - --mode "$mode" \
            --exposure-ms "$exposure_ms" --gain "$gain" \
            >"$reader_output" &
    fi
    reader_pid=$!
}

if [ -n "$flat_field" ]; then
    mkfifo "$stream_dir/raw-bayer.fifo"
    start_reader "$stream_dir/raw-bayer.fifo"
    "$flat_field_tool" apply --calibration "$flat_field" \
        --input "$stream_dir/raw-bayer.fifo" --output - \
        >"$stream_dir/bayer.fifo" &
    filter_pid=$!
else
    start_reader "$stream_dir/bayer.fifo"
fi
ffmpeg -hide_banner -loglevel warning -f rawvideo \
    -pixel_format bayer_grbg8 -video_size "${width}x${height}" -framerate 2 \
    -i "$stream_dir/bayer.fifo" -vf format=yuyv422 -f v4l2 "$device" &
writer_pid=$!

attempt=0
while [ "$attempt" -lt 50 ]; do
    if v4l2-ctl -d "$device" --all 2>/dev/null | grep -q 'Video Capture'; then
        break
    fi
    if ! kill -0 "$reader_pid" 2>/dev/null ||
       { [ "$filter_pid" -ne 0 ] && ! kill -0 "$filter_pid" 2>/dev/null; } ||
       ! kill -0 "$writer_pid" 2>/dev/null; then
        echo "V4L2 pipeline exited before the camera became ready" >&2
        exit 1
    fi
    sleep 0.1
    attempt=$((attempt + 1))
done
if [ "$attempt" -ge 50 ]; then
    echo "V4L2 writer did not become ready: $device" >&2
    exit 1
fi

echo "camera ready at $device; mode $mode ${width}x${height}; first unmodified device frame: $raw_output" >&2
if [ -n "$flat_field" ]; then
    echo "flat-field correction active: $flat_field" >&2
fi
if [ -n "$timestamps" ]; then
    echo "reader timestamp sidecar active: $timestamps" >&2
fi
echo "press Ctrl-C to stop and remove the temporary loopback device" >&2
set +e
wait "$reader_pid"
reader_status=$?
set -e
reader_pid=0
if [ "$requested_exit" -ne 0 ]; then
    exit "$requested_exit"
fi
if [ "$reader_status" -ne 0 ]; then
    echo "reader exited with status $reader_status" >&2
    exit "$reader_status"
fi
